# LLM API key — required for the Biomedical Expert chat agent (/chat).
# Groq is fast and OpenAI-compatible: get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ...or use OpenAI instead: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile   # Groq default (change to any Groq model id)
# LLM_MODEL=gpt-4o-mini               # OpenAI default
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT_SECONDS=25
